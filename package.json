{
  "name": "dsh-lab",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: instrument control via natural language",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc & tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.8"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.8",
    "tsdown": "^0.22.14",
    "typescript": "^5.6.0",
    "zod": "^3.24.0"
  },
   "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  }
}
